{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-news-discord",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "vars": {
    "ARTICLE_LIMIT": "5",
    "LOOKBACK_HOURS": "48"
  },
  "triggers": {"crons": ["0 23 * * *"]},
  "durable_objects": {
    "bindings": [{"name": "DIGEST", "class_name": "DigestDelivery"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["DigestDelivery"]}]
}
